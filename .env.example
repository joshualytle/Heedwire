# Heedwire secrets — copy this file to `.env` and fill in your values.
#
#   cp .env.example .env   # then edit .env
#
# Secrets come from the environment ONLY — never from config.yaml, never baked
# into the image, never committed. `.env` is gitignored; keep it that way.
# `docker compose` automatically loads `.env` from this directory at startup.

# REQUIRED to deliver alerts — your chat platform's incoming-webhook URL
# (Slack, Microsoft Teams via Power Automate Workflows, or Discord). Leave it
# blank and Heedwire still ingests and matches, but the delivery step errors
# (isolated to that output) and nothing is posted.
HEEDWIRE_WEBHOOK_URL=

# OPTIONAL dead-man's-switch ping URL (e.g. healthchecks.io, Uptime Kuma).
# Heedwire pings it after each successful run, and <url>/fail when a source
# errored. Leave blank to disable the heartbeat.
HEEDWIRE_HEARTBEAT_URL=
